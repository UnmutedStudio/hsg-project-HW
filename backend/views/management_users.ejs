<!DOCTYPE html>
<html lang="en-AU">
  <head>
    <%- include("partials/head.ejs") %>
    <title>High Street Gym - Manage Users</title>
  </head>
  <body>
    <main class="management-page">
      <%- include("partials/header_authenticated.ejs", {
        authenticatedUser: authenticatedUser,
        pageTitle: "Manage Users"
      }) %>
      <%- include("partials/nav.ejs", {authenticatedUser: authenticatedUser, role: authenticatedUser.role, activePage: "users"}) %>
      <section class="manage-heading">
        <div>
          <h2 class="text-2xl">Manage Users</h2>
          <p><%= users.length %> records</p>
        </div>
        <a
          href="/users#user-form"
          class="primary-button management-create-button"
        >
          Create New +
        </a>
      </section>
      <section class="management-filters">
        <form
          action="/users"
          method="get"
          class="management-filter-form"
        >
          <label for="search-term" class="sr-only">
            Search users:
          </label>
          <div class="crud-search-group">
            <input
              type="search"
              name="search_term"
              id="search-term"
              placeholder="Search users..."
            />
            <button
              type="submit"
              class="primary-button filter-button"
            >
              Search
            </button>
            <a
              href="/users"
              class="secondary-button filter-button"
            >
              Clear
            </a>
            <select
              name="user_filter"
              class="management-filter-select"
            >
              <option value="">All Roles</option>
              <% for (const role of userFilters) { %>
                <option
                  value="<%= role %>"
                  <%= selectedUserFilter === role ? 'selected' : '' %>
                >
                  <%= role %>
                </option>
              <% } %>
            </select>
            <button
              type="submit"
              class="primary-button filter-button"
            >
              Filter
            </button>
          </div>
        </form>
      </section>
      <section class="new-user management-form-section" id="user-form">
        <a
          href="/users"
          class="management-form-close"
          aria-label="Close form"
        >
          x
        </a>
        <% if (selectedUser.id == null) { %>
          <h3>Create User</h3>
        <% } else { %>
          <h3>Edit User</h3>
        <% } %>
        <form
          action="<%= selectedUser.id == null ? '/users' : '/users/' + selectedUser.id %>"
          method="post"
          class="form-grid management-form"
        >
          <label for="first-name">First Name:</label>
            <input
              type="text"
              name="firstName"
              id="first-name"
              value="<%= selectedUser.firstName %>"
              required
            />
          <label for="last-name">Last Name:</label>
          <input
            type="text"
            name="lastName"
            id="last-name"
            value="<%= selectedUser.lastName  %>"
            required
          />
          <label for="email">Email:</label>
            <input
              type="email"
              name="email"
              id="email"
              value="<%= selectedUser.email %>"
              required
            />
          <label for="role">Role:</label>
          <select name="role" id="role" required>
            <option value="admin" <%= selectedUser.role =="admin" ? "selected" : ""   %>>Admin</option>
            <option value="member" <%= selectedUser.role =="member" ? "selected" : ""   %>>Member</option>
            <option value="trainer" <%= selectedUser.role =="trainer" ? "selected" : ""   %>>Trainer</option>
          </select>
          <label for="password">Password:</label>
          <input
            type="password"
            name="password"
            id="password"
            <%= selectedUser.id == null ? "required" : ""  %>
          />
          <% if (selectedUser.id == null) { %>
          <button 
            class="primary-button two-col"
            type="submit"
            name="action"
            value="create"
          >
          Create New User </button>
        <% } else { %>
          <button 
            class="primary-button two-col"
            type="submit"
            name="action"
            value="update"
          >
          Update User</button>
          <!-- <button 
            class="primary-button two-col"
            type="submit"
            name="action"
            value="delete"
          >Delete User</button> -->
        <% } %>
        </form>
      </section>
      <section class="user-table columns-5 management-table">
        <span class="data-list-heading">
          <a href="/users?sort=<%= sortOrder === 'first_name_asc' ? 'first_name_desc' : 'first_name_asc' %>">
            First Name
            <%= sortOrder === 'first_name_desc' ? '▼' : '▲' %>
          </a>
        </span>
        <span class="data-list-heading">
          <a href="/users?sort=<%= sortOrder === 'last_name_asc' ? 'last_name_desc' : 'last_name_asc' %>">
            Last Name
            <%= sortOrder === 'last_name_desc' ? '▼' : '▲' %>
          </a>
        </span>
        <span class="data-list-heading">
          <a href="/users?sort=<%= sortOrder === 'email_asc' ? 'email_desc' : 'email_asc' %>">
            Email
            <%= sortOrder === 'email_desc' ? '▼' : '▲' %>
          </a>
        </span>
        <span class="data-list-heading">
          <a href="/users?sort=<%= sortOrder === 'role_asc' ? 'role_desc' : 'role_asc' %>">
            Role
            <%= sortOrder === 'role_desc' ? '▼' : '▲' %>
          </a>
        </span>
        <span class="data-list-heading">Actions</span>
        <% if (users.length == 0) { %>
          <div class="table-no-results">
          No users were found.
          </div>
        <% } %>
        <% for(const user of users ) { %>
          <div class="user-table-rows">
            <span><%= user.firstName %></span>
            <span><%= user.lastName %></span>
            <span><%= user.email %></span>
            <span><%= user.role %></span>
          <span class="table-actions">
            <a
              href="/users/<%= user.id %>#user-form"
              class="table-action"
            >
              Edit
            </a>
            <details class="delete-confirmation">
              <summary class="table-delete-action">
                Delete
              </summary>
              <div class="delete-confirmation-box">
                <p>Delete this user?</p>
                <form
                  action="/users/<%= user.id %>"
                  method="post"
                >
                  <button
                    type="submit"
                    name="action"
                    value="delete"
                    class="delete-button table-delete-button"
                  >
                    Confirm delete
                  </button>
                </form>
              </div>
            </details>
          </span>
          </div>
        <% } %>
      </section>
      <%- include("partials/footer.ejs") %>
    </main>
  </body>
</html>
