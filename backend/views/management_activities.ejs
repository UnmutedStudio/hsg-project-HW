<!DOCTYPE html>
<html lang="en-AU">
  <head>
    <%- include("partials/head.ejs") %>
    <title>High Street Gym - Manage Activities</title>
  </head>
  <body>
    <main class="management-page">
      <%- include("partials/header_authenticated.ejs", {
        authenticatedUser: authenticatedUser,
        pageTitle: ""
      }) %>
      <%- include("partials/nav.ejs", {authenticatedUser: authenticatedUser, role: authenticatedUser.role, activePage: "activities"}) %>
      <section class="manage-heading">
        <div>
          <h2 class="text-2xl">Manage Activities</h2>
          <p><%= activities.length %> records</p>
        </div>
        <a href="#activity-form" class="primary-button management-create-button">Create New +</a>
      </section>
      <section class="management-filters">
        <form
          action="/activities"
          method="get"  
          class="management-filter-form"
        >
        <label for="search-term" class="sr-only">Search activities:</label>
          <input
            type="search"
            name="search_term"
            id="search-term"
            placeholder="Search activities..."
          />
          <button type="submit" class="primary-button filter-button">Search</button>
          <a href="/activities" class="secondary-button filter-button">Clear</a>
          <details class="sort-menu" aria-label="Sort activities">
            <summary class="management-sort">
              Sort by name
            </summary>
          <div class="sort-menu-links">
            <a href="/activities?sort=default">
              Default</a>
            <a href="/activities?sort=asc">
              A-Z</a>
            <a href="/activities?sort=desc">
              Z-A</a>
          </div>
        </details>
        </form>
      </section>
       <section class="new-location management-form-section" id="activity-form">
        <a href="/activities" class="management-form-close" aria-label="Close form">x</a>
        <% if (selectedActivity.id == null) { %>
            <h3>Create Activity</h3>
        <% } else { %>
            <h3>Edit Activity</h3>
          <% } %>
        <form
          action="<%= selectedActivity.id == null ? '/activities' : '/activities/' + selectedActivity.id %>"
          method="post"
          class="form-grid management-form"
        >
          <label for="activity-name">Activity Name:</label>
            <input
              type="text"
              name="activityName"
              id="activity-name"
              value="<%= selectedActivity.activityName %>"
              minlength="2"
              maxlength="50"
              required
            />
          <label for="activity-description">Activity Description:</label>
            <textarea
              name="activityDescription"
              id="activity-description"
              minlength="2"
              maxlength="200"
              required
            ><%= selectedActivity.activityDescription %></textarea>
        <% if (selectedActivity.id == null) { %>
          <button 
            class="primary-button two-col"
            type="submit"
            name="action"
            value="create"
          >
          Create New Activity</button>
        <% } else { %>
          <button 
            class="primary-button two-col"
            type="submit"
            name="action"
            value="update"
          >
          Update Activity</button>
        <% } %>
        </form>
      </section>
      <section class="location-table columns-4 management-table">
        <span class="data-list-heading">Activity</span>
        <span class="data-list-heading">Description</span>
        <span class="data-list-heading">Status</span>
        <span class="data-list-heading">Actions</span>
        <% if (activities.length == 0) { %>
          <p>No activities were found.</p>
        <% } %>

        <% for(const activity of activities ) { %>
          <div class="activity-table-rows">
            <span><%= activity.activityName %></span>
            <span><%= activity.activityDescription %></span>
            <span class="status-cell">
              <% if (activity.deleted === 0) { %>
                <span class="status-pill status-active">Active</span>
              <% } else { %>
                <span class="status-pill status-inactive">Inactive</span>
              <% } %>
            </span>
            <span class="table-actions">
              <a href="/activities/<%= activity.id %>#activity-form" class="table-action">
                Edit</a>
              <details class="delete-confirmation">
                <summary class="table-delete-action">
                  Delete
                </summary>
                  <div class="delete-confirmation-box">
                    <p>Delete this activity?</p>  
                    <form
                      action="/activities/<%= activity.id %>"
                      method="post"
                    >
                    <button
                      type="submit"
                      name="action"
                      value="delete"
                      class="delete-button table-delete-button"
                    >Confirm delete
                    </button>
                  </form>
                </div>
              </details>
            </span>
          </div>
        <% } %>
      </section>
      <%- include("partials/footer.ejs") %>
    </main>
  </body>
</html>
