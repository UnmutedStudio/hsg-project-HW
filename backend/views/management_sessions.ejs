<!DOCTYPE html>
<html lang="en-AU">
  <head>
    <%- include("partials/head.ejs") %>
    <title>High Street Gym - Manage Sessions</title>
  </head>
  <body>
    <main class="management-page">
      <%- include("partials/header_authenticated.ejs", {
        authenticatedUser: authenticatedUser,
        pageTitle: "Manage Sessions",
      }) %>
      <%- include("partials/nav.ejs", {authenticatedUser: authenticatedUser, role: authenticatedUser.role, activePage: "sessions"}) %>
        <section class="manage-heading">
          <div>
            <h2 class="text-2xl">Manage Sessions</h2>
            <p><%= sessionDetails.length %> records</p>
          </div>
          <a href="/sessions/admin#session-form" class="primary-button management-create-button">
            Create New +
          </a>
        </section>
        <section class="management-filters">
          <form
            action="/sessions/admin"
            method="get"
            class="management-filter-form booking-filter-form"
          >
            <label for="search-term" class="sr-only">
              Search sessions:
            </label>
            <div class="crud-search-group">
              <input
                type="search"
                name="search_term"
                id="search-term"
                placeholder="Search sessions..."
              />
              <button
                type="submit"
                class="primary-button filter-button"
              >
                Search
              </button>
              <a
                href="/sessions/admin"
                class="secondary-button filter-button"
              >
                Clear
              </a>
            </div>

            <div class="crud-filter-group">
              <select
                name="activity_filter"
                class="management-filter-select"
              >
                <option value="">All Activities</option>
                <% for (const activityName of activityFilters) { %>
                  <option
                    value="<%= activityName %>"
                    <%= selectedActivityFilter === activityName ? 'selected' : '' %>
                  >
                    <%= activityName %>
                  </option>
                <% } %>
              </select>
              <select
                name="trainer_filter"
                class="management-filter-select"
              >
                <option value="">All Trainers</option>
                <% for (const trainerName of trainerFilters) { %>
                  <option
                    value="<%= trainerName %>"
                    <%= selectedTrainerFilter === trainerName ? 'selected' : '' %>
                  >
                    <%= trainerName %>
                  </option>
                <% } %>
              </select>
              <select
                name="location_filter"
                class="management-filter-select"
              >
                <option value="">All Locations</option>
                <% for (const locationName of locationFilters) { %>
                  <option
                    value="<%= locationName %>"
                    <%= selectedLocationFilter === locationName ? 'selected' : '' %>
                  >
                    <%= locationName %>
                  </option>
                <% } %>
              </select>
              <span class="date-range-label">
                Date range:
              </span>
              <label for="date-from" class="sr-only">
                Start date
              </label>
              <input
                type="date"
                name="date_from"
                id="date-from"
                value="<%= dateFrom %>"
                aria-label="Start date"
              />
              <label for="date-to" class="sr-only">
                End date
              </label>
              <input
                type="date"
                name="date_to"
                id="date-to"
                value="<%= dateTo %>"
                aria-label="End date"
              />
              <button
                type="submit"
                class="primary-button filter-button"
              >
                Filter
              </button>
            </div>
          </form>
        </section>
        <section class="new-session management-form-section" id="session-form">
          <a href="/sessions/admin" class="management-form-close" aria-label="Close form">x</a>
          <% if (selectedSession.id == null) { %>
            <h3>Create Session</h3>
          <% } else { %>
            <h3>Edit Session</h3>
          <% } %>
          <form
            action="<%= selectedSession.id == null ? '/sessions/admin' : '/sessions/admin/' + selectedSession.id %>"
            method="post"
            class="form-grid management-form"
          >
          <label for="activity-id">Activity:</label>
          <select
            name="activityId"
            id="activity-id"
            required
          >
          <option value="">Select activity</option>
          <% for (const activity of activities) { %>
          <option
            value="<%= activity.id %>"
            <%= selectedSession.activityId == activity.id
              ? "selected"
              : "" %>
          ><%= activity.activityName %></option>
          <% } %>
          </select>
            <label for="trainer-id">Trainer:</label>
          <select
            name="trainerId"
            id="trainer-id"
            required
          >
          <option value="">Select trainer</option>
          <% for (const trainer of trainers) { %>
          <option
            value="<%= trainer.id %>"
            <%= selectedSession.trainerId == trainer.id
              ? "selected"
              : "" %>
          ><%= trainer.firstName %> <%= trainer.lastName %></option>
          <% } %>
          </select>
            <label for="location-id">Location:</label>
          <select
            name="locationId"
            id="location-id"
            required
          >
          <option value="">Select location</option>
          <% for (const location of locations) { %>
          <option
            value="<%= location.id %>"
              <%= selectedSession.locationId == location.id
                ? "selected"
                : "" %>
            ><%= location.locationName %></option>
          <% } %>
          </select>
          <label for="date-session">Date:</label>
            <input
              type="date"
              name="dateSession"
              id="date-session"
              value="<%= selectedSession.dateSession
                ? selectedSession.dateSession.toLocaleDateString('en-CA')
                : '' %>"
              min="<%= new Date().toISOString().substring(0, 10) %>" 
              required
            />
          <label for="time-session">Time:</label>
            <input
              type="time"
              name="timeSession"
              id="time-session"
              value="<%= selectedSession.timeSession || '' %>"
              required
            />
          <label for="duration">Duration in minutes:</label>
            <input
              type="number"
              name="duration"
              id="duration"
              value="<%= selectedSession.duration || '' %>"
              min="1"
              required
            />
          <label for="availability">Available places:</label>
            <input
              type="number"
              name="availability"
              id="availability"
              value="<%= selectedSession.availability || '' %>"
              min="1"
              required
            />
            <% if (selectedSession.id == null) { %>
            <button 
              class="primary-button two-col"
              type="submit"
              name="action"
              value="create"
            >
            Create New Session </button>
          <% } else { %>
            <button 
              class="two-col"
              type="submit"
              name="action"
              value="update"
            >
            Update Session</button>
            <button 
              class="two-col"
              type="submit"
              name="action"
              value="delete"
            >Delete Session</button>
          <% } %>
          </form>
        </section>
        <section class="session-table columns-9 management-table">
          <span class="data-list-heading">
            <a href="/sessions/admin?sort=<%= sortOrder === 'activity_asc' ? 'activity_desc' : 'activity_asc' %>">
              Activity
              <%= sortOrder === 'activity_desc' ? '▼' : '▲' %>
            </a>
          </span>
          <span class="data-list-heading">
            <a href="/sessions/admin?sort=<%= sortOrder === 'trainer_asc' ? 'trainer_desc' : 'trainer_asc' %>">
              Trainer
              <%= sortOrder === 'trainer_desc' ? '▼' : '▲' %>
            </a>
          </span>
          <span class="data-list-heading">
            <a href="/sessions/admin?sort=<%= sortOrder === 'location_asc' ? 'location_desc' : 'location_asc' %>">
              Location
              <%= sortOrder === 'location_desc' ? '▼' : '▲' %>
            </a>
          </span>
          <span class="data-list-heading">
            <a href="/sessions/admin?sort=<%= sortOrder === 'date_asc' ? 'date_desc' : 'date_asc' %>">
              Date
              <%= sortOrder === 'date_desc' ? '▼' : '▲' %>
            </a>
          </span>
          <span class="data-list-heading">
            <a href="/sessions/admin?sort=<%= sortOrder === 'time_asc' ? 'time_desc' : 'time_asc' %>">
              Time
              <%= sortOrder === 'time_desc' ? '▼' : '▲' %>
            </a>
          </span>
          <span class="data-list-heading">
            <a href="/sessions/admin?sort=<%= sortOrder === 'duration_asc' ? 'duration_desc' : 'duration_asc' %>">
              Duration
              <%= sortOrder === 'duration_desc' ? '▼' : '▲' %>
            </a>
          </span>
          <span class="data-list-heading">
            <a href="/sessions/admin?sort=<%= sortOrder === 'availability_asc' ? 'availability_desc' : 'availability_asc' %>">
              Availability
              <%= sortOrder === 'availability_desc' ? '▼' : '▲' %>
            </a>
          </span>
          <span class="data-list-heading">Status</span>
          <span class="data-list-heading">Actions</span>
          <% if (sessionDetails.length == 0) { %>
            <div class="table-no-results">No sessions were found.</div>
          <% } %>
          <% for(const sessionDetail of sessionDetails ) { %>
            <div class="session-table-rows">
              <span><%= sessionDetail.activity.activityName %></span>
              <span><%= sessionDetail.trainer.firstName %> <%= sessionDetail.trainer.lastName %></span>
              <span><%= sessionDetail.location.locationName %></span>
              <span><%= sessionDetail.session.dateSession.toLocaleDateString("en-AU") %></span>
              <span><%= sessionDetail.session.timeSession %></span>
              <span><%= sessionDetail.session.duration %> minutes</span>
              <span><%= sessionDetail.session.availability %></span>
              <span class="status-cell">
                <% if (sessionDetail.session.availability > 0) { %>
                  <span class="status-pill status-active">
                    Active
                  </span>
                <% } else { %>
                  <span class="status-pill status-inactive">
                    Full
                  </span>
                <% } %>
              </span>
            <span class="table-actions">
            <a
              href="/sessions/admin/<%= sessionDetail.session.id %>#session-form"
              class="table-action"
            >
              Edit
            </a>
            <button
              type="button"
              class="table-delete-action"
              popovertarget="delete-session-<%= sessionDetail.session.id %>"
            >
              Delete
            </button>
            <div
              id="delete-session-<%= sessionDetail.session.id %>"
              class="delete-confirmation-popover"
              popover
            >
              <button
                type="button"
                class="delete-confirmation-close"
                popovertarget="delete-session-<%= sessionDetail.session.id %>"
                popovertargetaction="hide"
                aria-label="Close delete confirmation"
              >x
              </button>
              <p>Delete this session?</p>
              <form
                action="/sessions/trainer/<%= sessionDetail.session.id %>"
                method="post"
              >
                <button
                  type="submit"
                  name="action"
                  value="delete"
                  class="delete-button table-delete-button"
                >
                  Confirm delete
                </button>
              </form>
            </div>
            </span>
            </div>
          <% } %>
        </section>
      <%- include("partials/footer.ejs") %>
    </main>
  </body>
</html>