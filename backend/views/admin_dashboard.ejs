<!DOCTYPE html>
<html lang="en-AU">
  <head>
    <%- include("partials/head.ejs") %>
    <title>High Street Gym - Admin Dashboard</title>
  </head>
  <body>
    <main class="dashboard-page">
      <%- include("partials/header_authenticated.ejs", {
        authenticatedUser: authenticatedUser,
        pageTitle: "Admin Dashboard",
      }) %>
      <%- include("partials/nav.ejs", {
        authenticatedUser: authenticatedUser,
        role: authenticatedUser.role,
        activePage: "dashboard"
      }) %>
      <section class="admin-overview">
        <article class="overview-card">
          <span>Hello</span>
          <h2 class="text-2xl">
            <%= authenticatedUser.firstName %>
          </h2>
          <p>Welcome to the admin panel.</p>
        </article>
      </section>

      <section class="admin-section">
        <h2 class="text-2xl">Administration</h2>
        <div class="admin-card-list">
          <a href="/activities">
            <article class="admin-card">
              <h3>Activities</h3>
              <p>Manage activity types available at High Street Gym.</p>
            </article>
          </a>
          <a href="/blog-posts/admin">
            <article class="admin-card">
              <h3>Blog Posts</h3>
              <p>Create and manage blog content.</p>
            </article>
          </a>
          <a href="/bookings/admin">
            <article class="admin-card">
              <h3>Bookings</h3>
              <p>View and manage member session bookings.</p>
            </article>
          </a>
          <a href="/locations">
            <article class="admin-card">
              <h3>Locations</h3>
              <p>Manage gym locations.</p>                
            </article>
          </a>
          <a href="/sessions/admin">
            <article class="admin-card">
              <h3>Sessions</h3>
              <p>Create, edit and schedule training sessions.</p>
            </article>
          </a>
          <a href="/users">
            <article class="admin-card">
                <h3>Users</h3>
                <p>Manage member accounts, roles and permissions.</p>
            </article>
          </a>
        </div>
      </section>
      <%- include("partials/footer.ejs") %>
    </main>
  </body>
</html>