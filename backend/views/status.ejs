<!DOCTYPE html>
<html lang="en-AU">
    <head>
        <%- include("partials/head.ejs")  %>
        <title>High Street Gym - Status</title>
    </head>
    <body>
        <main>
            <% if (typeof authenticatedUser !== "undefined" && authenticatedUser) { %>
                <%- include("partials/header_authenticated.ejs", {
                    authenticatedUser: authenticatedUser,
                    pageTitle: status
                }) %>
            <% } else { %>
                <%- include("partials/header_guest.ejs", {
                    authenticatedUser: null,
                    pageTitle: status
            }) %>
            <% } %>
            <%- include("partials/nav.ejs", {
                authenticatedUser:
                    typeof authenticatedUser !== "undefined"
                    ? authenticatedUser
                    : null,
                role:
                    typeof authenticatedUser !== "undefined" && authenticatedUser
                    ? authenticatedUser.role
                    : null
            }) %>
            <section class="status-page">
            <article class="status-card responsive-half margin-auto">
                <div class="status-logo">H</div>
                <h2><%= status %></h2>
                <% if (typeof message !== "undefined") { %>
                    <p><%= message %></p>
                <% } %>
                <% if (status === "Logged out" ||
                    status === "Unauthenticated"
                ) { %>
                <a href="/" class="primary-button">
                    Login
                </a>
                <% } %>
            </article>
            </section>
            <%- include("partials/footer.ejs")  %>
        </main>
    </body>
</html>