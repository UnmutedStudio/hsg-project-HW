<!DOCTYPE html>
<html lang="en-AU">
  <head>
    <%- include("partials/head.ejs") %>
    <title>High Street Gym - Manage Blog Posts</title>
  </head>
  <body>
    <main class="management-page">
      <%- include("partials/header_authenticated.ejs", {
        authenticatedUser: authenticatedUser,
        pageTitle: ""
      }) %>
      <%- include("partials/nav.ejs", {authenticatedUser: authenticatedUser, role: authenticatedUser.role, activePage: "blog-posts"}) %>
      <section class="manage-heading">
        <div>
          <h2 class="text-2xl">Manage Blog Posts</h2>
          <p><%= blogPosts.length %> records</p>
        </div>
        <a href="#blog-form" class="primary-button management-create-button">Create New +</a>
      </section>
      <section class="management-filters">
        <form
          action="/blog-posts/admin"
          method="get"
          class="management-filter-form"
        >
          <label for="search-term" class="sr-only">
            Search blog posts:
          </label>
          <div class="crud-search-group">
            <input
              type="search"
              name="search_term"
              id="search-term"
              placeholder="Search blog posts..."
            />
            <button
              type="submit"
              class="primary-button filter-button"
            >
              Search
            </button>
            <a
              href="/blog-posts/admin"
              class="secondary-button filter-button"
            >
              Clear
            </a>
            <select
              name="author_filter"
              class="management-filter-select"
            >
              <option value="">All Authors</option>
              <% for (const authorName of authorFilters) { %>
                <option
                  value="<%= authorName %>"
                  <%= selectedAuthorFilter === authorName ? 'selected' : '' %>
                >
                  <%= authorName %>
                </option>
              <% } %>
            </select>
            <label for="blog-date-from" class="sr-only">
              Start date
            </label>
            <input
              type="date"
              name="date_from"
              id="blog-date-from"
              value="<%= dateFrom %>"
              aria-label="Start date"
            />

            <label for="blog-date-to" class="sr-only">
              End date
            </label>
            <input
              type="date"
              name="date_to"
              id="blog-date-to"
              value="<%= dateTo %>"
              aria-label="End date"
            />
            <button
              type="submit"
              class="primary-button filter-button"
            >
              Filter
            </button>
          </div>
        </form>
      </section>
      <section class="new-location management-form-section" id="blog-form">
        <a href="/blog-posts/admin" class="management-form-close" aria-label="Close form">x</a>
        <% if (selectedBlogPost.id == null) { %>
            <h3>Create Blog Post</h3>
          <% } %>
        <form
          action="<%= selectedBlogPost.id == null ? '/blog-posts/admin' : '/blog-posts/admin/' + selectedBlogPost.id %>"
          method="post"
          class="form-grid management-form"
        >
        <label for="title">Post Title:</label>
          <input
            type="text"
            name="title"
            id="title"
            value="<%= selectedBlogPost.title %>"
            minlength="2"
            maxlength="100"
            required
          />
          <label for="content">Post content:</label>
          <textarea
            name="content"
            id="content"
            minlength="2"
            maxlength="1000"
            required
          ><%= selectedBlogPost.content %></textarea>
        <% if (selectedBlogPost.id == null) { %>
          <button 
            class="primary-button two-col"
            type="submit"
            name="action"
            value="create"
          >
          Create New Blog Post</button>
        <% } %>
        </form>
      </section>
      <section class="location-table columns-5 management-table">
        <span class="data-list-heading">
          <a href="/blog-posts/admin?sort=<%= sortOrder === 'title_asc' ? 'title_desc' : 'title_asc' %>">
            Post Title <%= sortOrder === 'title_desc' ? '▼' : '▲' %>
          </a>
        </span>
                <span class="data-list-heading">
          <a href="/blog-posts/admin?sort=<%= sortOrder === 'author_asc' ? 'author_desc' : 'author_asc' %>">
            Author <%= sortOrder === 'author_desc' ? '▼' : '▲' %>
          </a>
        </span>
                <span class="data-list-heading">
          <a href="/blog-posts/admin?sort=<%= sortOrder === 'date_asc' ? 'date_desc' : 'date_asc' %>">
            Date Created <%= sortOrder === 'date_desc' ? '▼' : '▲' %>
          </a>
        </span>
        <span class="data-list-heading">Status</span>
        <span class="data-list-heading">Actions</span>
        <% if (blogPosts.length == 0) { %>
          <div class="table-no-results">
            No blog posts were found.
          </div>
        <% } %>
        <% for(const blogPostDetail of blogPosts ) { %>
          <div class="blog-table-rows">
            <span>
              <details> 
                <summary><%= blogPostDetail.blogPost.title %></summary>
                <p><%= blogPostDetail.blogPost.content %></p>
              </details>
            </span>
            <span>
              <%= blogPostDetail.user.firstName %>
              <%= blogPostDetail.user.lastName %>
            </span>
            <span><%= blogPostDetail.blogPost.dateCreated.toLocaleDateString("en-AU") %></span> 
              <span class="status-cell">
                <% if (blogPostDetail.blogPost.deleted === 0) { %>
                  <span class="status-pill status-active">
                    Posted
                  </span>
                <% } else { %>
                  <span class="status-pill status-inactive">
                    Deleted
                  </span>
                <% } %>
              </span>
            <span class="table-actions">
            <button
              type="button"
              class="table-delete-action"
              popovertarget="delete-blog-post-<%= blogPostDetail.blogPost.id %>"
            >
              Delete
            </button>
            <div
              id="delete-blog-post-<%= blogPostDetail.blogPost.id %>"
              class="delete-confirmation-popover"
              popover
            >
              <button
                type="button"
                class="delete-confirmation-close"
                popovertarget="delete-blog-post-<%= blogPostDetail.blogPost.id %>"
                popovertargetaction="hide"
                aria-label="Close delete confirmation"
              >
                x
              </button>
              <p>Delete this blog post?</p>
              <form
                action="/blog-posts/admin/<%= blogPostDetail.blogPost.id %>"
                method="post"
              >
                <button
                  type="submit"
                  name="action"
                  value="delete"
                  class="delete-button table-delete-button"
                >
                  Confirm delete
                </button>
              </form>
            </div>
            </span>
          </div>
        <% } %>
      </section>
      <%- include("partials/footer.ejs") %>
    </main>
  </body>
</html>
