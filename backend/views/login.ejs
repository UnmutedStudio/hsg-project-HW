<!DOCTYPE html>
<html lang="en-AU">
  <head>
    <%- include("partials/head.ejs") %>
    <title>High Street Gym - Login</title>
  </head>
  <body>
    <main class="auth-page">
      <%- include("partials/header_guest.ejs", { pageTitle: "Login"}) %>
      <section class="auth-card">
        <img class="form-logo" src="/img/logo300px.png" alt="High Street Gym">
        <div class="auth-intro">
          <h2>Welcome!</h2>
          <p>Log in to access all features of the app.</p>
        </div>
        <form
          action="/login"
          method="post"
          class="auth-form"
        >
          <label for="email" class="sr-only">Email</label>
          <input type="email" name="email" id="email" placeholder="Email*" autocomplete="email" required/>
          <label for="password" class="sr-only">Password</label>
          <input type="password" name="password" id="password" placeholder="Enter password*" autocomplete="current-password" required/>
          <small class="required-fields">
            *Required fields
          </small>
          <button
            type="submit"
            class="auth-button login-button"
          > Login
          </button>
        </form>
        <p class="not-mem">Not a member?</p>
        <a href="/signup" class="auth-button signup-button">
          Sign up
        </a>
      </section>
      <nav
        class="login-page-links"
        aria-label="login page"
      >
        <a href="/sessions">Session timetable</a>
        <a href="/blog-posts">Blog posts</a>
      </nav>
      <%- include("partials/footer") %>
    </main>
  </body>
</html>
