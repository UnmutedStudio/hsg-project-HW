<!DOCTYPE html>
<html lang="en-AU">
  <head>
    <%- include("partials/head.ejs") %>
    <title>High Street Gym - Session Timetable</title>
  </head>
  <body>
    <main class="timetable-page">
      <% if (authenticatedUser) { %>
        <%- include("partials/header_authenticated.ejs", {
          authenticatedUser: authenticatedUser,
          pageTitle: ""
        }) %>
      <% } else { %>
        <%- include("partials/header_guest.ejs", {
          authenticatedUser: null,
          pageTitle: "Session Timetable"
        }) %>
      <% } %>
      <%- include("partials/nav.ejs", {
        authenticatedUser: authenticatedUser,
        role: authenticatedUser ? authenticatedUser.role : null
      }) %>
      <section class="page-intro">
        <h2 class="text-2xl">Session Timetable</h2>
        <p>
          View the upcoming activities available at High Street Gym.
        </p>
      </section>
      <section class="management-filters">
        <form
          action="/sessions"
          method="get"
          class="management-filter-form"
        >
          <div class="activity-filter">
            <select
              name="activity_filter"
              class="management-filter-select"
            >
              <option value="">All Activities</option>
              <% for (const activityName of activityFilters) { %>
                <option
                  value="<%= activityName %>"
                  <%= selectedActivityFilter === activityName ? 'selected' : '' %>
                >
                  <%= activityName %>
                </option>
              <% } %>
            </select>
          </div>
          <div class="activity-filter">
            <select
              name="trainer_filter"
              class="management-filter-select"
            >
              <option value="">All Trainers</option>

              <% for (const trainerName of trainerFilters) { %>
                <option
                  value="<%= trainerName %>"
                  <%= selectedTrainerFilter === trainerName ? 'selected' : '' %>
                >
                  <%= trainerName %>
                </option>
              <% } %>
            </select>
          </div>
          <div class="activity-filter">
            <select
              name="location_filter"
              class="management-filter-select"
            >
            <option value="">All Locations</option>
              <% for (const locationName of locationFilters) { %>
                <option
                  value="<%= locationName %>"
                  <%= selectedLocationFilter === locationName ? 'selected' : '' %>
                >
                  <%= locationName %>
                </option>
              <% } %>
            </select>
          </div>
          <input
            type="date"
            name="date_from"
            id="date-from"
            value="<%= dateFrom %>"
          />
          <input
            type="date"
            name="date_to"
            id="date-to"
            value="<%= dateTo %>"
          />
          <button
            type="submit"
            class="primary-button filter-button"
          >
            Filter
          </button>
          <a href="/sessions" class="secondary-button filter-button">
            Clear
          </a>
        </form>
      </section>
      <section class="session-list">
        <% if (sessionDetails.length == 0) { %>
        <p>There are currently no sessions available.</p> 
        <% } %>

        <% for (let sessionDetail of sessionDetails) { %> 
        <article class="session-card">
          <h3><%= sessionDetail.activity.activityName %></h3>
          <p> Trainer: 
            <%= sessionDetail.trainer.firstName %> 
            <%= sessionDetail.trainer.lastName %>
          </p>
          <p> Location: 
            <%= sessionDetail.location.locationName %> 
          </p>
          <p><%= sessionDetail.session.dateSession.toLocaleDateString("en-AU", {
              weekday: "short",
              day: "numeric",
              month: "short"
            }) %> • <%= sessionDetail.session.timeSession.substring(0, 5) %></p>
          <p>Duration: <%= sessionDetail.session.duration %> minutes
          </p>
          <!-- check whether member is already booked in a session-->
          <% let isBooked = false; %>
          <% for ( let booking of bookings) { %>
            <% if (booking.booking.sessionId == sessionDetail.session.id) { %>
              <% isBooked = true; %>
            <% } %>
          <% } %>

          <div class="session-card-footer">
          <!--conditional displaying of the book now link when spots are available for the authenticated user-->
          <% if (authenticatedUser && authenticatedUser.role == "member") { %>
            <% if (isBooked) { %>
              <span class="session-status status-booked">Booked</span>
            <% } else if (sessionDetail.session.availability > 0) { %>
              <a href="/bookings/create/<%= sessionDetail.session.id %>" class="session-action">Book Now</a>
           <% } %>
          <% } %>
              <p class="session-availability">
          <%= sessionDetail.session.availability > 0 
            ? sessionDetail.session.availability + " spots left" 
            : "Full"
          %>
          </p>
          </div>
        </article>
        <% } %>
       </section>
      <%- include("partials/footer.ejs") %>
    </main>
  </body>
</html>


