<!DOCTYPE html>
<html lang="en-AU">
  <head>
    <%- include("partials/head.ejs") %>
    <title>High Street Gym - Review Booking</title>
  </head>
  <body>
    <main>
      <%- include("partials/header_authenticated.ejs", {
        authenticatedUser: authenticatedUser,
        pageTitle: "Review booking"
      }) %>
      <%- include("partials/nav.ejs", {
        authenticatedUser: authenticatedUser,
        role: authenticatedUser.role
      }) %>
      <section>
        <h2 class="text-2xl">Review your booking</h2>
        <p> Please check the session details before confirming your booking.</p>
      </section>
      <section class="booking-layout">
        <article class="session-card">
          <h3><%= sessionDetail.activity.activityName %></h3>
          <p> Trainer: <%= sessionDetail.trainer.firstName %> <%= sessionDetail.trainer.lastName %></p>
          <p> Location: <%= sessionDetail.location.locationName %> </p>
          <p>Date: <%= sessionDetail.session.dateSession.toLocaleDateString("en-AU") %></p>
          <p>Time: <%= sessionDetail.session.timeSession %></p>
          <p>Duration: <%= sessionDetail.session.duration %> minutes</p>
          <p>Available places: <%= sessionDetail.session.availability %></p>
        </article>
        <form
          action="/bookings/create"
          method="post"
          class="form-grid responsive-half margin-auto" >
          <input type="hidden" name="sessionId" value="<%= sessionDetail.session.id %>" />
          <a href="/sessions" class="link-button">Cancel</a>
          <button type="submit" name="action" value="create">Confirm booking</button>
        </form>
      </section>
      <%- include("partials/footer.ejs") %>
    </main>
  </body>
</html>
